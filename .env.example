# GEMINI_API_KEY: Optional if server-side Gemini features are enabled
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"

# ADMIN DASHBOARD AUTHENTICATION
# Optional: Set an initial master password, or configure directly on first run in the Admin Portal UI
ADMIN_PASSWORD="CHANGE_THIS_SECURE_ADMIN_PASSWORD"

# OPTIONAL: SMTP / Email Provider for Application Submission Notifications
# When configured, automatic confirmation alerts are dispatched to userjatin2007@gmail.com
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="notifications@jatinmehra.dev"
